# Local development only. Copy this file to .env and replace the password with
# a private local value. Production environments must inject their own values
# through their secret and configuration management systems.
DB_NAME=pr_review_assistant
DB_PORT=5432
DB_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/pr_review_assistant
DB_USERNAME=pr_review_assistant
DB_PASSWORD=replace-with-a-private-local-password
GITHUB_APP_ID=replace-with-your-github-app-id
GITHUB_PRIVATE_KEY_PATH=/path/to/github-app-private-key.pem
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=replace-with-a-random-high-entropy-webhook-secret
GITHUB_WEBHOOK_MAX_BODY_SIZE=1MB
PR_FETCH_MAX_FILES=1000
PR_FETCH_MAX_PATCH_BYTES_PER_FILE=256KB
PR_FETCH_MAX_TOTAL_PATCH_BYTES=5MB
PR_FETCH_MAX_PAGES=10
PR_FETCH_MAX_RESPONSE_BODY_SIZE=8MB
REVIEW_WORKER_ENABLED=false
REVIEW_CONTEXT_ENABLED=true
REVIEW_CONTEXT_MAX_FILES=12
REVIEW_CONTEXT_MAX_FILE_BYTES=128KB
REVIEW_CONTEXT_MAX_TOTAL_BYTES=512KB
REVIEW_CONTEXT_MAX_CHANGED_FILE_BYTES=128KB
REVIEW_CONTEXT_MAX_LINES_PER_FILE=200
REVIEW_CONTEXT_MAX_CANDIDATES=100
REVIEW_CONTEXT_MAX_API_REQUESTS=20
REVIEW_WORKER_POLL_INTERVAL=5s
REVIEW_WORKER_BATCH_SIZE=10
REVIEW_WORKER_LEASE_DURATION=2m
REVIEW_JOB_MAX_ATTEMPTS=3
REVIEW_JOB_RETRY_BASE_DELAY=10s
REVIEW_JOB_RETRY_MAX_DELAY=5m
REVIEW_AI_ENABLED=false
REVIEW_USAGE_MONTHLY_LIMIT=50
REPOSITORY_CONFIG_MAX_SIZE=32KB
REVIEW_AI_MAX_FINDINGS=5
REVIEW_AI_MINIMUM_CANDIDATE_CONFIDENCE=70
REVIEW_SUPPRESSION_MINIMUM_CONFIDENCE=85
REVIEW_SUPPRESSION_MINIMUM_SEVERITY=MEDIUM
REVIEW_SUPPRESSION_MAX_PUBLISHABLE_FINDINGS=3
REVIEW_PUBLICATION_ENABLED=false
REVIEW_PUBLICATION_MAX_SUMMARY_CHARS=6000
REVIEW_PUBLICATION_MAX_COMMENT_CHARS=2000
REVIEW_PUBLICATION_MAX_PAYLOAD_CHARS=20000
REVIEW_PUBLICATION_RECONCILIATION_MAX_PAGES=10
REVIEW_PUBLICATION_MAX_ATTEMPTS=3
REVIEW_PUBLICATION_RETRY_BASE_DELAY=10s
REVIEW_PUBLICATION_RETRY_MAX_DELAY=5m
REVIEW_PUBLICATION_POLL_INTERVAL=5s
REVIEW_PUBLICATION_BATCH_SIZE=10
REVIEW_PUBLICATION_LEASE_DURATION=2m
AI_PROVIDER=openai
AI_MAX_INPUT_CHARS=120000
AI_MAX_SCHEMA_BYTES=64KB
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_TIMEOUT=60s
OPENAI_MAX_RETRIES=1
BACKEND_BASE_URL=http://127.0.0.1:8080
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
AUTH0_SECRET=replace-with-32-random-bytes-encoded-as-64-hex-characters
AUTH0_AUDIENCE=https://api.review-assistant.example
APP_BASE_URL=http://localhost:3000
DASHBOARD_AUTH_ISSUER=https://your-tenant.auth0.com/
DASHBOARD_AUTH_AUDIENCE=https://api.review-assistant.example
DASHBOARD_AUTH_JWK_SET_URI=https://your-tenant.auth0.com/.well-known/jwks.json
